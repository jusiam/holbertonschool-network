#!/bin/bash

# File to modify
HOSTS_FILE="/etc/hosts"

# Backup the original /etc/hosts file if not already backed up
if [ ! -f "$HOSTS_FILE.bak" ]; then
    echo "Backing up $HOSTS_FILE to $HOSTS_FILE.bak"
    sudo cp "$HOSTS_FILE" "$HOSTS_FILE.bak"
else
    echo "Backup already exists at $HOSTS_FILE.bak"
fi

# Update localhost to resolve to 127.0.0.2
if grep -q "^127.0.0.1\s\+localhost" "$HOSTS_FILE"; then
    echo "Updating localhost to resolve to 127.0.0.2"
    sudo sed -i 's/^127.0.0.1\s\+localhost/127.0.0.2 localhost/' "$HOSTS_FILE"
else
    echo "Adding 127.0.0.2 localhost to $HOSTS_FILE"
    echo "127.0.0.2 localhost" | sudo tee -a "$HOSTS_FILE"
fi

# Add facebook.com to resolve to 8.8.8.8
if grep -q "facebook.com" "$HOSTS_FILE"; then
    echo "Updating facebook.com to resolve to 8.8.8.8"
    sudo sed -i '/facebook.com/c\8.8.8.8 facebook.com' "$HOSTS_FILE"
else
    echo "Adding 8.8.8.8 facebook.com to $HOSTS_FILE"
    echo "8.8.8.8 facebook.com" | sudo tee -a "$HOSTS_FILE"
fi

# Verify changes
echo "Updated $HOSTS_FILE content:"
cat "$HOSTS_FILE"

echo "Configuration complete. To revert changes, restore the backup using:"
echo "sudo cp $HOSTS_FILE.bak $HOSTS_FILE"
